# ==============================================================================
# Siva M Portfolio - Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file or SMTP passwords to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Client Origins for CORS (comma-separated if multiple, e.g. for Vercel)
CLIENT_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app

# ==============================================================================
# Contact Form & Email Provider Configuration
# ==============================================================================
# Target inbox where visitor inquiries must be delivered
CONTACT_RECEIVER_EMAIL=manikounder1984@gmail.com
CONTACT_RECIPIENT_EMAIL=manikounder1984@gmail.com

# SMTP Provider Settings (e.g. Gmail, SendGrid, Brevo, AWS SES, Mailgun)
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_gmail_address@gmail.com
#   SMTP_PASS=your_16_character_google_app_password
#   (Generate via: Google Account -> Security -> 2-Step Verification -> App Passwords)
#
# For SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=your_sendgrid_api_key
#
# For Brevo (formerly Sendinblue):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_brevo_login_email
#   SMTP_PASS=your_brevo_smtp_master_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# ==============================================================================
# Optional Database Storage
# ==============================================================================
# MongoDB Connection String (leave blank to run in stateless in-memory mode)
# e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/portfolio
MONGO_URI=
